<Window x:Class="SnmpBrowser.PluginApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Attiva plugin" Width="640" SizeToContent="Height" MaxHeight="760"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock x:Name="NameText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="DescText" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="AUTORE (DICHIARATO DAL PLUGIN)" Style="{StaticResource FieldLabel}" />
                    <TextBlock x:Name="AuthorText" Margin="0,0,0,10" TextWrapping="Wrap" />
                    <TextBlock Text="ID" Style="{StaticResource FieldLabel}" />
                    <TextBlock x:Name="IdText" Margin="0,0,0,10" FontFamily="Consolas" />
                    <TextBlock Text="IMPRONTA SHA-256 DEL CODICE" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="HashBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="COSA PUO' FARE" Style="{StaticResource FieldLabel}" />
                    <TextBlock x:Name="PermText" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Expander Header="Mostra il codice dello script" Margin="0,12,0,0" Foreground="{DynamicResource MutedBrush}">
                <TextBox x:Name="CodeBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12" Margin="0,8,0,0"
                         AcceptsReturn="True" MaxHeight="260" HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto" />
            </Expander>

            <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                       Text="Lo script gira in un interprete isolato: non puo' leggere file, usare la rete o lanciare programmi. Puo' solo fare quello che e' elencato sopra. Se il codice cambia (nuova versione) dovrai approvare di nuovo." />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Annulla" Style="{StaticResource SecondaryButton}" IsCancel="True" />
                <Button Content="Attiva plugin" Margin="8,0,0,0" IsDefault="True" Click="ApproveButton_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
