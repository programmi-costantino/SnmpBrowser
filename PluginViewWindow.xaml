<Window x:Class="SnmpBrowser.PluginViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Plugin" Width="760" Height="520" MinWidth="420" MinHeight="260"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        Loaded="Window_Loaded">
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" LastChildFill="False">
            <TextBlock x:Name="HeaderText" DockPanel.Dock="Left" FontSize="18" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <Button x:Name="CopyButton" DockPanel.Dock="Right" Content="Copia" Margin="8,0,0,0"
                    Style="{StaticResource SecondaryButton}" Click="CopyButton_Click" />
            <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="Aggiorna" Click="RefreshButton_Click" />
        </DockPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource MutedBrush}" />
        <Border Style="{StaticResource Card}" Padding="0">
            <Grid>
                <DataGrid x:Name="TableGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          Visibility="Collapsed" />
                <TextBox x:Name="TextBody" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="14"
                         FontFamily="Consolas" Background="Transparent" />
            </Grid>
        </Border>
    </DockPanel>
</Window>
