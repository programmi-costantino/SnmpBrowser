<Window x:Class="SnmpBrowser.PersonalSourceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sorgente personale" Width="580" SizeToContent="Height" MinHeight="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" FontFamily="Segoe UI"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}">
    <StackPanel Margin="20">
        <TextBlock x:Name="TitleText" Text="Nuova sorgente personale" FontSize="18" FontWeight="SemiBold" />
        <TextBlock TextWrapping="Wrap" Margin="0,4,0,14" Foreground="{DynamicResource MutedBrush}"
                   Text="Un tuo repository git con le MIB, anche privato. Resta solo su questo PC e compare nella tabella del Repository MIB, con tag e branch nel menu delle versioni." />

        <TextBlock Text="NOME" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="NameBox" Margin="0,0,0,12" MaxLength="40" />

        <TextBlock Text="URL DEL REPOSITORY (HTTPS)" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="UrlBox" Margin="0,0,0,12" FontFamily="Consolas" />

        <TextBlock Text="TOKEN DI ACCESSO (SOLO PER REPOSITORY PRIVATI)" Style="{StaticResource FieldLabel}" />
        <PasswordBox x:Name="TokenBox" />
        <TextBlock x:Name="TokenHint" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource MutedBrush}" />
        <CheckBox x:Name="ClearTokenBox" Margin="0,6,0,0" Content="Rimuovi il token salvato"
                  Foreground="{DynamicResource TextBrush}" Visibility="Collapsed" />

        <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="12">
            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                       Text="Come creare il token su GitHub: Settings > Developer settings > Personal access tokens > Fine-grained tokens. Seleziona solo questo repository, permesso Contents: Read-only, e imposta una scadenza. Il token viene salvato cifrato per il tuo utente Windows e non e' mai scritto in chiaro." />
        </Border>

        <TextBlock x:Name="MessageText" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource MutedBrush}" />

        <DockPanel Margin="0,14,0,0" LastChildFill="False">
            <Button x:Name="TestButton" Content="Verifica connessione" DockPanel.Dock="Left"
                    Style="{StaticResource SecondaryButton}" Click="TestButton_Click" />
            <Button x:Name="DeleteButton" Content="Elimina sorgente" DockPanel.Dock="Left" Margin="8,0,0,0"
                    Style="{StaticResource DangerButton}" Visibility="Collapsed" Click="DeleteButton_Click" />
            <Button x:Name="SaveButton" Content="Salva" DockPanel.Dock="Right" IsDefault="True" Click="SaveButton_Click" />
            <Button Content="Annulla" DockPanel.Dock="Right" Margin="0,0,8,0" IsCancel="True"
                    Style="{StaticResource SecondaryButton}" />
        </DockPanel>
    </StackPanel>
</Window>
