<Window x:Class="SnmpBrowser.MibWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Librerie MIB" Width="860" Height="540" MinWidth="680" MinHeight="400"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        AllowDrop="True" PreviewDragOver="Window_DragOver" PreviewDrop="Window_Drop">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Librerie MIB" FontSize="18" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource MutedBrush}"
                       Text="Carica i file MIB scaricati da internet (.mib, .txt, .my...) oppure trascinali qui. Una volta caricati, gli OID vengono mostrati con il loro nome e la loro descrizione, e puoi digitare i nomi (es. IF-MIB::ifDescr) al posto dei numeri." />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <DataGrid x:Name="ModulesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Modulo" Binding="{Binding Name}" Width="200" />
                        <DataGridTextColumn Header="Simboli" Binding="{Binding SymbolCount}" Width="80" />
                        <DataGridTextColumn Header="Stato" Binding="{Binding StatusText}" Width="*" />
                        <DataGridTextColumn Header="Origine" Binding="{Binding OriginText}" Width="150" />
                        <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="160" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" Foreground="{DynamicResource PlaceholderBrush}" FontSize="14"
                           IsHitTestVisible="False"
                           Text="Nessuna MIB caricata&#x0A;Premi &quot;Aggiungi file...&quot; o trascina qui i file MIB" />
            </Grid>
        </Border>

        <TextBlock x:Name="MessageText" Grid.Row="2" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource MutedBrush}" />

        <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="False">
            <Button x:Name="AddButton" Content="Aggiungi file..." DockPanel.Dock="Left" Click="AddButton_Click" />
            <Button x:Name="RemoveButton" Content="Rimuovi selezionata" DockPanel.Dock="Left" Margin="8,0,0,0"
                    Style="{StaticResource DangerButton}" Click="RemoveButton_Click" />
            <TextBlock x:Name="SummaryText" DockPanel.Dock="Left" Margin="16,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedBrush}" FontSize="12" />
            <Button Content="Chiudi" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}"
                    IsDefault="True" Click="CloseButton_Click" />
        </DockPanel>
    </Grid>
</Window>
