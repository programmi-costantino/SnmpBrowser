<UserControl x:Class="SnmpBrowser.CatalogPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SnmpBrowser"
             FontFamily="Segoe UI" Foreground="{DynamicResource TextBrush}"
             Loaded="Panel_Loaded" Unloaded="Panel_Unloaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="IntroText" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,12"
                   Foreground="{DynamicResource MutedBrush}" />

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="URL DEL REPOSITORY" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="UrlBox" FontFamily="Consolas" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="10,0,0,0">
                    <Button x:Name="InstallFileButton" Content="Installa da file..." Visibility="Collapsed"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="InstallFileButton_Click"
                            ToolTip="Installa un plugin da una cartella o da un file .zip, senza rete" />
                    <Button x:Name="AddPersonalButton" Content="Aggiungi sorgente personale..."
                            Style="{StaticResource SecondaryButton}" Click="AddPersonalButton_Click" />
                    <Button x:Name="SyncButton" Content="Aggiorna elenco" Margin="8,0,0,0" Click="SyncButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <DataGrid x:Name="PackagesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" HeadersVisibility="Column" RowHeight="38">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Pacchetto" Binding="{Binding Name}" Width="150" />
                        <DataGridTextColumn Header="Sorgente" Binding="{Binding SourceText}" Width="70" />
                        <DataGridTextColumn Header="Installata" Binding="{Binding InstalledText}" Width="130" />
                        <DataGridTemplateColumn Header="Versione" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding Versions}"
                                              SelectedItem="{Binding SelectedVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectionChanged="VersionBox_SelectionChanged"
                                              MinHeight="26" Padding="8,2,26,2" Margin="0,2"
                                              IsEnabled="{Binding IsBusy, Converter={x:Static local:InverseBool.Instance}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Ultima" Binding="{Binding LatestText}" Width="130" />
                        <DataGridTextColumn Header="Stato" Binding="{Binding StatusText}" Width="150" />
                        <DataGridTemplateColumn Header="Azioni" Width="*" MinWidth="440">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{Binding ActionText}" IsEnabled="{Binding CanApply}"
                                                Padding="14,4" MinWidth="86" Click="ApplyButton_Click" />
                                        <Button Content="{Binding PluginActionText}" Margin="6,0,0,0" Padding="12,4"
                                                MinWidth="76"
                                                IsEnabled="{Binding IsBusy, Converter={x:Static local:InverseBool.Instance}}"
                                                Visibility="{Binding PluginActionVisible, Converter={StaticResource BoolToVis}}"
                                                Click="PluginButton_Click" />
                                        <Button Content="MQTT..." Margin="6,0,0,0" Padding="12,4"
                                                Style="{StaticResource SecondaryButton}"
                                                Visibility="{Binding PluginMqttVisible, Converter={StaticResource BoolToVis}}"
                                                Click="MqttButton_Click" />
                                        <Button Content="Rimuovi" IsEnabled="{Binding CanRemove}" Margin="6,0,0,0"
                                                Padding="12,4" Style="{StaticResource SecondaryButton}"
                                                Click="RemoveButton_Click" />
                                        <Button Content="Modifica" Margin="6,0,0,0" Padding="12,4"
                                                Style="{StaticResource SecondaryButton}"
                                                Visibility="{Binding IsPersonal, Converter={StaticResource BoolToVis}}"
                                                Click="EditButton_Click" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" Foreground="{DynamicResource PlaceholderBrush}" FontSize="14"
                           IsHitTestVisible="False" Text="Nessun pacchetto&#x0A;Premi &quot;Aggiorna elenco&quot;" />
            </Grid>
        </Border>

        <TextBlock x:Name="MessageText" Grid.Row="3" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource MutedBrush}" />
    </Grid>
</UserControl>
