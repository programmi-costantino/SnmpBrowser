<Window x:Class="SnmpBrowser.PluginMqttWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Credenziali MQTT" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}">
    <StackPanel Margin="20">
        <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="BrokerText" Margin="0,4,0,0" FontFamily="Consolas" Foreground="{DynamicResource MutedBrush}" />

        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="UTENTE (LASCIA VUOTO SE IL BROKER NON LO RICHIEDE)" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="UserBox" Margin="0,0,0,10" />
                <TextBlock Text="PASSWORD" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="PassBox" />
                <TextBlock x:Name="HintText" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedBrush}"
                           Text="Le credenziali restano su questo PC (cifrate per il tuo utente Windows) e non sono visibili al plugin: le usa l'app per collegarsi al broker." />
            </StackPanel>
        </Border>

        <TextBlock x:Name="ResultText" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="TestButton" Content="Prova connessione" Style="{StaticResource SecondaryButton}" Click="TestButton_Click" />
            <Button Content="Annulla" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" IsCancel="True" />
            <Button Content="Salva" Margin="8,0,0,0" IsDefault="True" Click="SaveButton_Click" />
        </StackPanel>
    </StackPanel>
</Window>
