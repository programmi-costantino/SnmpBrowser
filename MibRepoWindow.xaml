<Window x:Class="SnmpBrowser.MibRepoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Repository MIB e plugin" Width="1160" Height="640" MinWidth="940" MinHeight="460"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        Loaded="Window_Loaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <RadioButton x:Name="MibTab" Content="MIB" GroupName="tabs" IsChecked="True"
                         Style="{StaticResource TabPill}" Checked="Tab_Checked" />
            <RadioButton x:Name="PluginTab" Content="Plugin" GroupName="tabs" Margin="8,0,0,0"
                         Style="{StaticResource TabPill}" Checked="Tab_Checked" />
        </StackPanel>

        <Grid x:Name="Host" Grid.Row="1" />

        <DockPanel Grid.Row="2" Margin="0,10,0,0" LastChildFill="False">
            <TextBlock x:Name="GitText" DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource MutedBrush}" />
            <Button Content="Chiudi" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}"
                    IsDefault="True" Click="CloseButton_Click" />
        </DockPanel>
    </Grid>
</Window>
