<Window x:Class="SnmpBrowser.MibRepoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SnmpBrowser"
        Title="Repository MIB" Width="1120" Height="600" MinWidth="900" MinHeight="420"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        Loaded="Window_Loaded">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Repository MIB" FontSize="18" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource MutedBrush}"
                       Text="Libreria condivisa di MIB. Scegli la versione di ogni pacchetto dal menu e premi Installa / Applica: l'app scarica solo quello che ti serve." />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="URL DEL REPOSITORY" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="UrlBox" FontFamily="Consolas" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="10,0,0,0">
                    <Button x:Name="AddPersonalButton" Content="Aggiungi sorgente personale..."
                            Style="{StaticResource SecondaryButton}" Click="AddPersonalButton_Click" />
                    <Button x:Name="SyncButton" Content="Aggiorna elenco" Margin="8,0,0,0" Click="SyncButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <DataGrid x:Name="PackagesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" HeadersVisibility="Column" RowHeight="38">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Pacchetto" Binding="{Binding Name}" Width="190" />
                        <DataGridTextColumn Header="Sorgente" Binding="{Binding SourceText}" Width="85" />
                        <DataGridTextColumn Header="Installata" Binding="{Binding InstalledText}" Width="100" />
                        <DataGridTemplateColumn Header="Versione" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding Versions}"
                                              SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                                              MinHeight="26" Padding="8,2,26,2" Margin="0,2"
                                              IsEnabled="{Binding IsBusy, Converter={x:Static local:InverseBool.Instance}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Ultima" Binding="{Binding LatestText}" Width="90" />
                        <DataGridTextColumn Header="Stato" Binding="{Binding StatusText}" Width="*" />
                        <DataGridTemplateColumn Header="Azioni" Width="300">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{Binding ActionText}" IsEnabled="{Binding CanApply}"
                                                Padding="14,4" MinWidth="86" Click="ApplyButton_Click" />
                                        <Button Content="Rimuovi" IsEnabled="{Binding CanRemove}" Margin="6,0,0,0"
                                                Padding="12,4" Style="{StaticResource SecondaryButton}"
                                                Click="RemoveButton_Click" />
                                        <Button Content="Modifica" Margin="6,0,0,0" Padding="12,4"
                                                Style="{StaticResource SecondaryButton}"
                                                Visibility="{Binding IsPersonal, Converter={StaticResource BoolToVis}}"
                                                Click="EditButton_Click" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" Foreground="{DynamicResource PlaceholderBrush}" FontSize="14"
                           IsHitTestVisible="False" Text="Nessun pacchetto&#x0A;Premi &quot;Aggiorna elenco&quot;" />
            </Grid>
        </Border>

        <TextBlock x:Name="MessageText" Grid.Row="3" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource MutedBrush}" />

        <DockPanel Grid.Row="4" Margin="0,10,0,0" LastChildFill="False">
            <TextBlock x:Name="GitText" DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource MutedBrush}" />
            <Button Content="Chiudi" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}"
                    IsDefault="True" Click="CloseButton_Click" />
        </DockPanel>
    </Grid>
</Window>
